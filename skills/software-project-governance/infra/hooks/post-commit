#!/bin/bash
# post-commit governance hook — installed by software-project-governance
# Fires after every git commit. Forces governance visibility at each commit point.
# @version: 0.82.0

set -e

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")

resolve_spg_home_candidate() {
    local candidate="$1"
    [ -n "$candidate" ] || return 1

    if [ -f "$candidate/SKILL.md" ] && [ -d "$candidate/infra/hooks" ]; then
        echo "$candidate"
        return 0
    fi

    if [ -f "$candidate/skills/software-project-governance/SKILL.md" ]; then
        echo "$candidate/skills/software-project-governance"
        return 0
    fi

    return 1
}

find_spg_home() {
    local resolved
    local dsh_preset_root="${DSH_HOME:-$HOME/.dsh}/.agent-presets/governance"
    local dsh_link_root=""
    local dsh_link_home=""
    dsh_link_root=$(cat "$dsh_preset_root/skill-root.txt" 2>/dev/null || true)
    if [ -n "$dsh_link_root" ]; then
        dsh_link_home="$dsh_link_root/skills/software-project-governance"
    fi
    for candidate in \
        "$SOFTWARE_PROJECT_GOVERNANCE_HOME" \
        "$SPG_HOME" \
        "$REPO_ROOT/skills/software-project-governance" \
        "$dsh_preset_root/skills/software-project-governance" \
        "$dsh_link_home"
    do
        resolved=$(resolve_spg_home_candidate "$candidate" 2>/dev/null || true)
        if [ -n "$resolved" ]; then
            echo "$resolved"
            return 0
        fi
    done

    local base
    local found
    for base in \
        "$HOME/.claude/plugins/cache" \
        "$HOME/.codex/plugins/cache" \
        "$XDG_CACHE_HOME/claude/plugins/cache" \
        "$XDG_CACHE_HOME/codex/plugins/cache"
    do
        [ -d "$base" ] || continue
        found=$(find "$base" -path "*/skills/software-project-governance/SKILL.md" -type f 2>/dev/null | sort -V 2>/dev/null | tail -n 1)
        if [ -z "$found" ]; then
            found=$(find "$base" -path "*/skills/software-project-governance/SKILL.md" -type f 2>/dev/null | sort | tail -n 1)
        fi
        if [ -n "$found" ]; then
            dirname "$found"
            return 0
        fi
    done

    return 1
}

normalize_existing_path() {
    local path="$1"
    local dir
    local base
    [ -n "$path" ] || return 1

    dir=$(dirname "$path")
    base=$(basename "$path")
    if [ -d "$dir" ]; then
        (cd "$dir" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$base")
        return $?
    fi

    if command -v realpath >/dev/null 2>&1; then
        realpath "$path" 2>/dev/null && return 0
    fi

    return 1
}

SPG_RESOLVED_HOME=$(find_spg_home 2>/dev/null || true)

# --- Step 0: Hook self-upgrade check (FIX-046/FIX-132) ---
# Installed hooks may live in external projects without a repo-local
# skills/software-project-governance copy. Resolve source from explicit env,
# repo-local install, or common plugin cache locations before comparing.
# Only the actual installed .git/hooks copy may self-upgrade. Source hooks may
# be run through relative paths during tests or development and must not be
# overwritten by another installed/cache runtime.
HOOK_NAME=$(basename "$0")
SOURCE_HOOK=""
if [ -n "$SPG_RESOLVED_HOME" ]; then
    SOURCE_HOOK="$SPG_RESOLVED_HOME/infra/hooks/$HOOK_NAME"
fi
SELF_HOOK=$(normalize_existing_path "$0" 2>/dev/null || printf '%s\n' "$0")
GIT_HOOK_PATH=$(git rev-parse --git-path "hooks/$HOOK_NAME" 2>/dev/null || true)
INSTALLED_HOOK=""
if [ -n "$GIT_HOOK_PATH" ]; then
    INSTALLED_HOOK=$(normalize_existing_path "$GIT_HOOK_PATH" 2>/dev/null || true)
fi
SOURCE_HOOK_REAL=""
if [ -n "$SOURCE_HOOK" ]; then
    SOURCE_HOOK_REAL=$(normalize_existing_path "$SOURCE_HOOK" 2>/dev/null || true)
fi
SOURCE_HOOK_PATH="${SOURCE_HOOK_REAL:-$SOURCE_HOOK}"
if [ -n "$INSTALLED_HOOK" ] && [ "$SELF_HOOK" = "$INSTALLED_HOOK" ] && [ -f "$SOURCE_HOOK_PATH" ] && [ "$SELF_HOOK" != "$SOURCE_HOOK_PATH" ]; then
    if ! cmp -s "$SELF_HOOK" "$SOURCE_HOOK_PATH" 2>/dev/null; then
        SOURCE_VER=$(grep '@version:' "$SOURCE_HOOK" 2>/dev/null | head -1 | sed 's/.*@version: *//')
        cp "$SOURCE_HOOK_PATH" "$SELF_HOOK" 2>/dev/null && \
            chmod +x "$SELF_HOOK" 2>/dev/null && \
            echo "🔄 GOVERNANCE: Hook '$HOOK_NAME' self-upgraded to v${SOURCE_VER:-?}. Restarting with latest version..." && \
            exec "$SELF_HOOK" "$@"
    fi
fi

# --- Step 1: Extract task ID from commit message ---
COMMIT_MSG=$(git log -1 --format=%B)
TASK_ID=$(echo "$COMMIT_MSG" | grep -oE '[A-Z]+-[0-9]+' | head -1)

# FIX-044/FIX-133: Safety net — cleanup legacy GOV_COMMIT_MSG bridge state.
# Current message checks never read this file; commit-msg is authoritative via $1.
GOV_COMMIT_MSG_PATH=$(git rev-parse --git-path GOV_COMMIT_MSG 2>/dev/null || true)
if [ -n "$GOV_COMMIT_MSG_PATH" ]; then
    rm -f "$GOV_COMMIT_MSG_PATH" 2>/dev/null || true
fi

# --- Step 2: Check task traceability ---
if [ -z "$TASK_ID" ]; then
    echo ""
    echo "⚠️  GOVERNANCE: Commit message has NO task ID reference."
    echo "   Expected format: 'AUDIT-XXX: description' or 'FIX-XXX: description'"
    echo "   This commit is NOT traceable to plan-tracker tasks."
    echo "   Action: Update plan-tracker or amend commit message."
    echo ""
else
    # Check if evidence exists for this task (handles comma-separated and range IDs)
    if [ -f "$REPO_ROOT/.governance/evidence-log.md" ]; then
        if grep -qE "$TASK_ID" "$REPO_ROOT/.governance/evidence-log.md" 2>/dev/null; then
            echo ""
            echo "✅ GOVERNANCE: Commit '$TASK_ID' — evidence found in evidence-log."
            echo ""
        else
            echo ""
            echo "╔══════════════════════════════════════════════════════════════╗"
            echo "║  M7.4 VIOLATION: Commit '$TASK_ID' has NO evidence.         ║"
            echo "║                                                            ║"
            echo "║  Task Completion Protocol: evidence → check-governance      ║"
            echo "║  → audit → commit → continue. You committed without         ║"
            echo "║  evidence. This is the most common M7.4 failure pattern.    ║"
            echo "║                                                            ║"
            echo "║  Action: Add evidence NOW (before next commit).             ║"
            echo "║  DO NOT start another task until evidence is logged.        ║"
            echo "╚══════════════════════════════════════════════════════════════╝"
            echo ""
        fi
    fi
fi

# --- Step 3: Check if plan-tracker knows about this task ---
if [ -n "$TASK_ID" ] && [ -f "$REPO_ROOT/.governance/plan-tracker.md" ]; then
    if ! grep -q "| $TASK_ID |" "$REPO_ROOT/.governance/plan-tracker.md" 2>/dev/null; then
        echo "⚠️  GOVERNANCE: Task '$TASK_ID' not found in plan-tracker."
        echo "   This task was NOT recorded before work started."
        echo "   Action: Add task to plan-tracker or use correct task ID."
        echo ""
    fi
fi

# --- Step 4: Quick governance summary ---
VERIFY_WORKFLOW=""
if [ -f "$REPO_ROOT/scripts/verify_workflow.py" ]; then
    VERIFY_WORKFLOW="$REPO_ROOT/scripts/verify_workflow.py"
elif [ -n "$SPG_RESOLVED_HOME" ] && [ -f "$SPG_RESOLVED_HOME/infra/verify_workflow.py" ]; then
    VERIFY_WORKFLOW="$SPG_RESOLVED_HOME/infra/verify_workflow.py"
fi

if [ -n "$VERIFY_WORKFLOW" ]; then
    echo "--- Governance Quick Check ---"
    python "$VERIFY_WORKFLOW" check-governance 2>/dev/null | \
        grep -E "(Check [0-9]|PASS|WARN|issued)" | head -12
    echo "-------------------------------"
fi

# --- Step 4b: governance-write-guard panel wiring (FEAT-017 / AUDIT-150 §10) ---
# Immediate post-commit visibility of the .governance structural write guard
# (FEAT-011 subcommand, FIX-297 follow-up). Before this wiring a Coordinator
# direct-write breach surfaced only in the NEXT session (check-governance);
# now it surfaces at the commit point. Panel idiom matches the existing
# steps: ✅ one-liner = pass, ╔═╗ box = violation, ⚠️ one-liner = degraded
# disclosure (these hooks emit no ANSI color codes — emoji + box carry the
# green/red semantics, same vocabulary as Steps 2-4 above).
#
# Verdict mapping (honest — never reports a verdict it does not have):
#   rc=0 with a "Result: PASS" line → ✅ PASS one-liner (with elapsed time)
#   rc=1 with a "Result: FAIL" line → ❌ FAIL box (first issues + rerun cmd)
#   rc=124/137                       → guard timed out → ⚠️ UNAVAILABLE
#   any other rc / missing verdict   → invocation failed (python missing,
#     script crash, subcommand absent) → ⚠️ UNAVAILABLE. The Result-line gate
#     matters: an uncaught python exception ALSO exits rc=1, and rendering a
#     crashed guard as FAIL would be a false verdict.
#   .governance/ absent / verify_workflow.py unresolved → ⚠️ SKIPPED.
# This step NEVER blocks and never aborts the hook: post-commit is advisory
# by design and every command below is guarded against `set -e`; the hook's
# flow continues to Step 5 with an unchanged status.
#
# ROLLBACK (documented revert path, FEAT-017 acceptance 3): delete this
# whole Step 4b block. That restores the FIX-297 scheme-2 posture — the pure
# protocol rule (behavior-protocol.md M1.2 "直写后 MUST 复跑
# governance-write-guard") with discovery deferred to the next session's
# check-governance run. All variables below are SPG_WG_* section-local; no
# later step reads them, so removal is self-contained.
if [ ! -d "$REPO_ROOT/.governance" ]; then
    echo "⚠️  GOVERNANCE: write-guard SKIPPED — no .governance/ in this repo (guard target absent)."
elif [ -z "$VERIFY_WORKFLOW" ]; then
    echo "⚠️  GOVERNANCE: write-guard SKIPPED — verify_workflow.py not found (guard command unavailable)."
else
    SPG_WG_TIMEOUT_SECONDS=30
    SPG_WG_PY=""
    if command -v python >/dev/null 2>&1; then
        SPG_WG_PY="python"
    elif command -v python3 >/dev/null 2>&1; then
        SPG_WG_PY="python3"
    fi
    if [ -z "$SPG_WG_PY" ]; then
        echo "⚠️  GOVERNANCE: write-guard SKIPPED — no python interpreter found (guard command unavailable)."
    else
        # Timeout protection (FEAT-017 acceptance 2; hooks had no prior
        # timeout precedent to copy — conservative semantic probe instead):
        # only wrap the call when `timeout` is verifiably GNU coreutils.
        # Git-bash/WSL/Linux ship it (/usr/bin/timeout — kills the child on
        # expiry, rc=124). Windows System32 timeout.exe is a PAUSE command
        # that would swallow the guard silently; the probe rejects it (empty
        # `--version` stdout → no "GNU coreutils" banner) and the call runs
        # unwrapped instead of mis-wrapped.
        spg_wg_invoke() {
            if timeout --version 2>/dev/null | head -1 | grep -q "GNU coreutils"; then
                timeout "$SPG_WG_TIMEOUT_SECONDS" "$SPG_WG_PY" "$VERIFY_WORKFLOW" \
                    governance-write-guard --project-root "$REPO_ROOT"
            else
                "$SPG_WG_PY" "$VERIFY_WORKFLOW" governance-write-guard \
                    --project-root "$REPO_ROOT"
            fi
        }
        # date +%s%N sanitized through tr: BSD/macOS date prints a literal
        # trailing "N" for unsupported %N — tr strips it so $((...)) never
        # sees a non-numeric token (degrades to whole-second precision).
        SPG_WG_T0=$(date +%s%N 2>/dev/null | tr -cd '0-9')
        SPG_WG_RC=0
        SPG_WG_OUT=$(spg_wg_invoke 2>/dev/null) || SPG_WG_RC=$?
        SPG_WG_T1=$(date +%s%N 2>/dev/null | tr -cd '0-9')
        SPG_WG_ELAPSED=""
        if [ -n "$SPG_WG_T0" ] && [ -n "$SPG_WG_T1" ] && [ "$SPG_WG_T0" -le "$SPG_WG_T1" ] 2>/dev/null; then
            SPG_WG_ELAPSED=" ($(( (SPG_WG_T1 - SPG_WG_T0) / 1000000 ))ms)"
        fi
        case "$SPG_WG_RC" in
            0)
                if printf '%s\n' "$SPG_WG_OUT" | grep -q '^Result: PASS'; then
                    echo "✅ GOVERNANCE: write-guard PASS — .governance 结构检查通过${SPG_WG_ELAPSED}"
                else
                    echo "⚠️  GOVERNANCE: write-guard UNAVAILABLE — guard returned rc=0 without a PASS verdict line (unexpected output shape; no verdict reported)."
                fi
                ;;
            1)
                if printf '%s\n' "$SPG_WG_OUT" | grep -q '^Result: FAIL'; then
                    SPG_WG_COUNT=$(printf '%s\n' "$SPG_WG_OUT" | grep -c '^ *- ' || true)
                    echo ""
                    echo "╔══════════════════════════════════════════════════════════════╗"
                    echo "║  ❌ WRITE-GUARD FAIL: .governance 直写结构违规              ║"
                    echo "║  (FEAT-011 guard verdict — 直写产物形状缺陷, writer 需修复) ║"
                    echo "║                                                            ║"
                    echo "║  ${SPG_WG_COUNT} issue(s) — first 3 shown (full report: rerun):"
                    printf '%s\n' "$SPG_WG_OUT" | grep '^ *- ' | head -3 | sed 's/^ */║    /'
                    echo "║                                                            ║"
                    echo "║  Guard is check-only (零 .governance 写入) — fix the writer."
                    echo "║  Rerun for line numbers + expected shapes:"
                    echo "║    ${SPG_WG_PY} \"${VERIFY_WORKFLOW}\" governance-write-guard --project-root \"${REPO_ROOT}\""
                    echo "╚══════════════════════════════════════════════════════════════╝"
                    echo ""
                else
                    echo "⚠️  GOVERNANCE: write-guard UNAVAILABLE — invocation failed (rc=1 without a FAIL verdict line — tooling error, not a governance FAIL; no verdict reported)."
                fi
                ;;
            124|137)
                echo "⚠️  GOVERNANCE: write-guard UNAVAILABLE — timed out after ${SPG_WG_TIMEOUT_SECONDS}s (no verdict; post-commit not blocked)."
                ;;
            *)
                echo "⚠️  GOVERNANCE: write-guard UNAVAILABLE — invocation failed (rc=${SPG_WG_RC}; no verdict — tooling error, not a governance FAIL)."
                ;;
        esac
    fi
fi

# --- Step 5: Agent lock cleanup + scope creep detection (FIX-056 Phase 2) ---
LOCKS_FILE="$REPO_ROOT/.governance/agent-locks.json"
if [ -f "$LOCKS_FILE" ]; then
    # 5a. Scope creep: detect if agent-locks.json was accidentally committed
    if git diff-tree --no-commit-id -r HEAD --name-only 2>/dev/null | grep -q "\.governance/agent-locks\.json"; then
        echo ""
        echo "⚠️  GOVERNANCE: agent-locks.json was included in this commit."
        echo "   agent-locks.json is a runtime lock state file and should NOT"
        echo "   be committed to version control."
        echo "   Action: confirm .gitignore includes .governance/ or add:"
        echo "     echo '.governance/agent-locks.json' >> .gitignore"
        echo "   Then unstage: git rm --cached .governance/agent-locks.json"
        echo ""
    fi

    # 5b. Cleanup: release lock entries for the task just committed (task ID match)
    if [ -n "$TASK_ID" ]; then
        python3 -c "
import json, sys, os
locks_path = os.path.expandvars(r'$LOCKS_FILE')
task_id = os.path.expandvars(r'$TASK_ID')
try:
    with open(locks_path, 'r') as f:
        data = json.load(f)
    cleaned = 0
    # Remove active_tasks entry matching this task_id
    if 'active_tasks' in data and isinstance(data['active_tasks'], dict):
        if task_id in data['active_tasks']:
            del data['active_tasks'][task_id]
            cleaned += 1
    # Remove file_locks entries locked by this task_id
    if 'file_locks' in data and isinstance(data['file_locks'], dict):
        to_remove = [fp for fp, e in data['file_locks'].items()
                     if isinstance(e, dict) and e.get('locked_by') == task_id]
        for fp in to_remove:
            del data['file_locks'][fp]
            cleaned += 1
    if cleaned > 0:
        with open(locks_path, 'w') as f:
            json.dump(data, f, indent=2)
            f.write('\n')
        print(f'🔒 FIX-056: Released {cleaned} lock(s) for {task_id} (task completed).')
except Exception as e:
    print(f'⚠️  FIX-056: Failed to clean locks for {task_id}: {e}', file=sys.stderr)
" 2>/dev/null || true
    fi

    # 5c. Scope creep: detect if committed files are locked by ANOTHER task
    CHANGED_FILES=$(git diff-tree --no-commit-id -r HEAD --name-only 2>/dev/null | tr '\n' ' ')
    if [ -n "$CHANGED_FILES" ]; then
        python3 -c "
import json, sys, os
locks_path = os.path.expandvars(r'$LOCKS_FILE')
task_id = os.path.expandvars(r'$TASK_ID')
changed_raw = os.path.expandvars(r'$CHANGED_FILES')
changed = set(f for f in changed_raw.split() if f.strip())
try:
    with open(locks_path, 'r') as f:
        data = json.load(f)
    if 'file_locks' in data and isinstance(data['file_locks'], dict):
        for fp, entry in data['file_locks'].items():
            if fp in changed and isinstance(entry, dict):
                locker = entry.get('locked_by', 'unknown')
                if locker != task_id:
                    print(f'⚠️  SCOPE CREEP: {fp} modified in this commit ({task_id}) '
                          f'but currently locked by {locker} — possible concurrent Agent conflict.')
except Exception as e:
    pass
" 2>/dev/null || true
    fi
fi
