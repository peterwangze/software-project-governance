{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@peterwangze/software-project-governance-plugin",
  "version": "0.99.0",
  "private": true,
  "license": "MIT",
  "description": "AI coding delivery trust layer with shared governance skills, commands and agent roles, packaged for zcode and DeepSeek Harness.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "governance",
    "project-governance",
    "ai-coding-agent",
    "agent-workflow",
    "skills"
  ],
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "agent-presets/",
    "skills/",
    "commands/",
    "agents/",
    "adapters/dsh/",
    "adapters/*/adapter-manifest.json",
    "docs/reviews/review-FEAT-086-DESIGN-R0.md",
    "!**/__pycache__/",
    "!**/*.pyc",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
