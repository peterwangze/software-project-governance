  "cleanup_scope": {
    "description": "Top-level plugin directories that cleanup.py may scan for redundant product artifacts. User project files outside this scope are never cleanup candidates.",
    "directories": [
      "adapters",
      "agent-presets",
      "agents",
      "commands",
      "lib",
      "skills",
      ".agents",
      ".claude-plugin",
      ".codex-plugin",
      ".zcode-plugin"
    ]
  },
  "exclude_from_cleanup": {
    "description": "Paths NEVER considered redundant, even if not in the manifest above. These are user-generated or external.",
    "entries": [
      ".git/",
      "node_modules/",
      "__pycache__/",
      "*.pyc",
      ".env",
      ".env.*",
      "*.log"
    ],
    "user_data_dirs": [
      ".governance/"
    ]
  }
