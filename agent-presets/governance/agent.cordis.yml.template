# The `governance` agent preset for the software-project-governance workflow.
#
# This file is a TEMPLATE and the SINGLE composition source for the dsh
# adapter: `agent-presets/governance/` holds the preset payload (this template
# + preset.yml) and nothing else. Two renderers substitute the
# `__GOVERNANCE_*__` tokens with ABSOLUTE paths and write the result to
# `${DSH_HOME}/.agent-presets/governance/agent.cordis.yml`:
#   * `lib/index.js` `ensurePreset()` — the inserted bundle row, on boot;
#   * `adapters/dsh/launch.py --install` — the manual / offline path.
# Do not mount this template directly, and do not rename it to
# `agent.cordis.yml`: a token-bearing composition under that name would be
# discovered as a mountable preset by `dsh-agent-presets` and would silently
# register the literal `__GOVERNANCE_*__` strings as skill roots. The
# `.template` suffix is what keeps it render-only, and `dsh_compat`'s
# `**/*.cordis.yml.template` glob validates it against the installed schemas.
#
# Absolute, not relative, roots: `customSkillDirs` entries are resolved with
# Node `path.resolve` against the dsh PROCESS CWD (installed dsh:
# dsh-skill-filesystem/lib/index.js) and the user-root copy sits outside this
# package, so only absolute paths are correct. The package stays the single
# source of the skill content: there is no copied `skills/` tree anywhere, and
# no literal relative entry (a documented live-regression class — the catalog
# silently empties and `/governance` disappears).
#
# Loading model (thin projection): the workflow rules stay in the repository's
# shared skill (`skills/software-project-governance/SKILL.md`). This preset only
# (a) gives the agent the Coordinator persona + bootstrap, (b) registers the
# repo's skills/ directory plus the adapters/dsh/skill-shims/ command
# projections as custom skill roots so the native `skill` tool exposes the
# whole workflow catalog, and (c) keeps the full standard coding-agent toolset
# so role agents can be spawned with the same composition (dsh children
# inherit their parent's preset).
#
# Structure mirrors the shipped `standard` preset: every row outside an
# `isolate` group resolves a host-plane registry, and no service is published
# into the root realm.

# ── identity ────────────────────────────────────────────────────────────────

# The Coordinator persona + DSH governance bootstrap, shadowing the deployment
# default for this agent. `{{model}}` and `{{cwd}}` resolve from the agent's
# own route and workspace; `__GOVERNANCE_REPO_ROOT__` is substituted at render
# time (launch.py / ensurePreset) with the package root, which is what
# `<plugin_root>` in the persona body resolves to.
- id: persona
  name: '@deepseek-ai/dsh-persona'
  config:
    prefix: |-
      You are a coding agent powered by the {{model}} model, running on the DeepSeek Harness. Your working directory is {{cwd}}.

      你是 software-project-governance 治理工作流（v0.89.0）的 Coordinator，不是单 agent 任务执行者。治理插件仓库根目录：__GOVERNANCE_REPO_ROOT__（下称 <plugin_root>）。infra 命令一律用绝对路径执行，不解析 $WORKFLOW_HOME。

      每会话第一动作（bootstrap，fail-closed）：
      1. 调用 `skill` 工具加载 `software-project-governance`（resourceBase 即 skill 目录 <plugin_root>/skills/software-project-governance），遵循其全部规则。
      2. 用 `pwsh` 执行：python "<plugin_root>/skills/software-project-governance/infra/resolve_entry.py" --json
      3. resolved_root_ok == false → MUST STOP，展示 diagnostic，不呈现治理状态（DEC-080 / RISK-038）。
      4. resolved_root_ok == true → governance-bootstrap --format json 取热数据，立即呈现最小状态行 + ask_user_question 首次交互（FEAT-034）；深检后置按需执行，推进类动作前 MUST 补齐。

      行为灰度开关（FEAT-040）：GOVERNANCE_LEGACY_BEHAVIOR=1 或 plan-tracker ## 项目配置 的 behavior_profile: legacy → 只回退性能行为；**安全语义不回退**（升级确认门/异常不隐藏/fail-closed/真实环境防护/复审必达）。生效形态见 governance-bootstrap 的 behavior 面。

      SELF-CHECK：即将输出问句 → 改用 ask_user_question；到达交互边界 → MUST ask_user_question（完整六条：SKILL.md「Bootstrap 规程明细」§B0）。
      模式确认：每会话一句（always-on/on-demand/silent-track 句式与治理开关语句映射：§B0）。

      Agent Team（DSH）：用 `subagent` spawn 角色 agent——prompt = 角色定义 <plugin_root>/agents/<role>.md 全文 + 任务规范 + 调度模板 <plugin_root>/skills/software-project-governance/references/agent-dispatch-template.md；spawn 前查 .governance/agent-locks.json 并写锁、完成释放；用户交互只经 ask_user_question，sub-agent 不接触用户（详见 SKILL.md「Sub-agent 调度」）。

      关键行为契约（MUST；完整规则：behavior-protocol.md M7.4/M7.7 + SKILL.md「关键行为契约」）：
      - 复审必达：NEEDS_CHANGE 且 round<3（触发器 T1）→ MUST 立即 spawn 同一 Reviewer 复审（round+1，注入前轮 review 报告路径），不得跳过/不得询问；round≥3（T2）→ BLOCKED + escalation；仅 APPROVED 或 unresolved_blockers=0 的 APPROVED_WITH_NOTES 为通过终态。
      - 完成必推荐：任务标记已完成 → MUST 运行 task-priority-analysis（fail-closed 不跳过），快照入 evidence-log，推荐 1~3 候选（含依赖理由，DEC-143 自动推荐+用户确认）；空推荐 → 结构化空原因；MUST NOT 直接结束会话。
      - 选项必带依据：候选 MUST 可追溯依赖分析输出，禁止机械枚举。
      - 审查结论必机录：review-record 持久化（NEEDS_CHANGE 自动 next_round）；禁手写 REVIEW 行。
      - 真实环境必防护：$HOME/$DSH_HOME/仓库外操作前三选一（隔离环境/完整备份+一致性校验/用户逐项授权）并留痕，缺一禁执行；每条命令逐条上报并由 Coordinator 机写 evidence；验收措辞用「隔离环境安装冒烟（环境变量重定向至临时目录）通过」。

      Git hooks 缺失 → 提醒一次性安装：cp "<plugin_root>/skills/software-project-governance/infra/hooks/"* .git/hooks/
      版本升级（DSH 无 /plugin update）：git -C "<plugin_root>" pull && python "<plugin_root>/adapters/dsh/launch.py" --sync；下次会话自动完成其余。

- id: agent-instructions
  name: '@deepseek-ai/dsh-agent-instructions'
  config:
    maxBytes: 65536

# ── shell ───────────────────────────────────────────────────────────────────

# `shell-env` stays in the HOST composition; both shell tools consume the host
# registry from here.
- id: tool-bash
  name: '@deepseek-ai/dsh-tool-bash'
  disabled: !!js process.platform === 'win32'

- id: tool-pwsh
  name: '@deepseek-ai/dsh-tool-pwsh'
  disabled: !!js process.platform !== 'win32'

# ── filesystem ──────────────────────────────────────────────────────────────

- id: tool-fs
  name: '@deepseek-ai/dsh-tool-fs'

- id: tool-fs-search
  name: '@deepseek-ai/dsh-tool-fs-search'
  config:
    sampleOverCapGlobResults: false

# ── background jobs ────────────────────────────────────────────────────────

- id: tool-jobs
  name: '@deepseek-ai/dsh-tool-jobs'

# ── skills ──────────────────────────────────────────────────────────────────

# The workflow catalog travels with the repository, not with a copied skill
# tree: both roots below point at the package checkout (substituted at render
# time), so `git pull` + a re-render is the skill update. The second root is a
# flat skill root: `adapters/dsh/skill-shims/` holds thin name+description
# shims over `commands/*.md`, which makes `/governance` and friends first-class
# dsh skills (the `/name` user gesture loads them) without touching the shared
# command files. Registration happens in THIS preset's layer of the host skill
# registry, so no realm is needed.
- id: skill-filesystem
  name: '@deepseek-ai/dsh-skill-filesystem'
  config:
    customSkillDirs:
      - '__GOVERNANCE_SKILLS_ROOT__'
      - '__GOVERNANCE_SHIMS_ROOT__'

- id: tool-skill
  name: '@deepseek-ai/dsh-tool-skill'

# ── goals ───────────────────────────────────────────────────────────────────

- id: tool-goal
  name: '@deepseek-ai/dsh-tool-goal'

# ── plan mode ───────────────────────────────────────────────────────────────

- id: planning
  name: cordis:group
  group: true
  isolate:
    planMode: true
  config:
    - id: plan-mode
      name: '@deepseek-ai/dsh-plan-mode'
      config:
        section: |
              You are in plan mode. Stay in plan mode until exit_plan_mode succeeds or the user switches the session mode. Imperative language to implement changes means plan the implementation, not execute it. A user's conversational agreement — including an answer confirming something you asked — approves nothing and does not end plan mode; fold the confirmed decision into the plan and submit it through exit_plan_mode.

              Explore first. Use non-mutating reads, searches, static analysis, and checks to ground the plan in the actual repository. Do not edit or write files, change configuration, run formatters or code generation that rewrites tracked files, commit, or otherwise carry out the plan. Prefer existing functions and patterns over new machinery.

              The tool catalog stays the same across modes for request-cache stability. These plan-mode rules override any later tool description or guidance that suggests using mutation tools; those tools remain listed to keep the tool catalog unchanged. Do not use todo_write to track this planning phase: it tracks implementation after an approved plan, while the plan itself belongs in exit_plan_mode.

              Resolve discoverable facts by inspection. Use ask_user_question only for user-owned choices or material ambiguity that inspection cannot answer. Do not ask the user where code lives or how current behavior works when you can find out.

              Make the plan decision-complete: state the goal and success criteria; group implementation changes by subsystem; identify public API, schema, and data-flow changes; cover edge cases, failure modes, tests, acceptance criteria, and explicit assumptions. Keep it concise enough to review but detailed enough that another engineer can implement it without making design decisions.

              When ready, call exit_plan_mode with the complete plan markdown, starting with a # title. Make exit_plan_mode the only and final tool call in that assistant response: it presents the plan for approval, and implementation begins only in a later step after approval. Do not paste the final plan as a plain reply or ask "should I proceed?" through prose or ask_user_question. If review rejects it, incorporate the feedback and present again. If the review channel is unavailable or aborted, stay in plan mode and ask the user to switch modes manually; do not proceed with implementation.

# ── compaction ──────────────────────────────────────────────────────────────

- id: compaction
  name: cordis:group
  group: true
  isolate:
    compaction: true
    toolResultPruner: true
  config:
    - id: compaction-basic
      name: '@deepseek-ai/dsh-compaction-basic'

    - id: command-compact
      name: '@deepseek-ai/dsh-command-compact'

    - id: tool-result-pruner
      name: '@deepseek-ai/dsh-compaction-tool-result-pruner'
      config:
        thresholdChars: 8192
        headChars: 4096
        tailChars: 1024

# ── delegation and workflows ────────────────────────────────────────────────

# The `subagents` registry and its spawn/fork backends live in the HOST
# composition; this preset contributes the delegation TOOLS. Role agents are
# spawned through `subagent` with prompts assembled from <plugin_root>/agents/.
- id: delegation
  name: cordis:group
  group: true
  isolate:
    workflowEngine: true
  config:
    - id: tool-subagent-control
      name: '@deepseek-ai/dsh-tool-subagent-control'

    - id: tool-subagent-list-agents
      name: '@deepseek-ai/dsh-tool-subagent-control/list-agents'

    - id: tool-subagent
      name: '@deepseek-ai/dsh-tool-subagent'
      config:
        provider: spawn
        toolName: subagent
        backgroundMode: continuable

    - id: tool-subagent-fork
      name: '@deepseek-ai/dsh-tool-subagent'
      config:
        provider: fork
        toolName: subagent_fork
        backgroundMode: continuable

    # Product providers are host-plane singletons; kept disabled like standard.
    - id: tool-subagent-codex
      name: '@deepseek-ai/dsh-tool-subagent'
      disabled: true
      config:
        provider: codex
        toolName: subagent_codex
        enableRunInBackground: false
        maxDepth: provider-managed

    - id: tool-subagent-claude-code
      name: '@deepseek-ai/dsh-tool-subagent'
      disabled: true
      config:
        provider: claude-code
        toolName: subagent_claude_code
        enableRunInBackground: false
        maxDepth: provider-managed

    - id: workflow-worker-thread
      name: '@deepseek-ai/dsh-workflow-worker-thread'
      config:
        provider: spawn

    - id: tool-workflow
      name: '@deepseek-ai/dsh-tool-workflow'

    - id: tool-ralph
      name: '@deepseek-ai/dsh-tool-ralph'
      config:
        subagentProvider: spawn
        maxRounds: 64

# ── remaining model-facing rows ─────────────────────────────────────────────

- id: tool-ask-user
  name: '@deepseek-ai/dsh-tool-ask-user'

- id: tool-todo
  name: '@deepseek-ai/dsh-tool-todo'
  config:
    allowParallelInProgress: true

# The `web` service and its search provider stay in the host composition; only
# the model-facing tool is per-session.
- id: tool-web
  name: '@deepseek-ai/dsh-tool-web'
  config:
    fetch: false
    searchTimeoutMs: 60000
